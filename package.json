{
  "name": "incus-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev/proxy.ts",
    "dev:vite": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:incus-types": "node scripts/api/generate.mjs",
    "test:incus": "node --experimental-strip-types --test \"shared/data/tests/**/*.test.ts\"",
    "test:dev": "node --experimental-strip-types --test \"tests/dev/**/*.test.ts\"",
    "test:browser": "node --test --test-concurrency=2 \"tests/browser/**/*.test.mjs\" \"shared/components/tests/browser/**/*.test.mjs\"",
    "test:components:browser": "node --test --test-concurrency=2 \"shared/components/tests/browser/**/*.test.mjs\"",
    "test:architecture": "node --test \"tests/architecture/**/*.test.mjs\"",
    "test:artifacts": "node --test \"tests/artifacts/**/*.test.mjs\"",
    "test:vem-package": "node scripts/checks/vem-package.mjs",
    "test:affected": "node --experimental-strip-types scripts/checks/affected.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test:react": "vitest run --config vitest.config.ts",
    "test:react:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hyecompany/vem-data": "2.0.0",
    "@hyecompany/vem-ui": "1.0.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-router": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.0",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "^7.30.0"
  }
}
