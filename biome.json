{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"shared/data/tests/**",
			"tests/dev/**",
			"tests/react/**",
			"shared/state/tests/**",
			"shared/components/tests/**",
			"vitest.config.ts",
			"tests/browser/**",
			"tests/architecture/**",
			"!**/src/routeTree.gen.ts",
			"!**/transport/generated",
			"!**/dist",
			"!**/src/styles.css",
			"scripts/**/*.ts",
			"scripts/**/*.mjs",
			"tests/artifacts/**",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
